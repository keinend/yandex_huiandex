{
  "name": "yandex-smart-home-control",
  "private": true,
  "version": "2.0.6",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron-dev": "node scripts/electron-wait-for-vite.js",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "fetch-cookie": "^3.2.0",
    "hls.js": "^1.6.16",
    "keytar": "^7.9.0",
    "lucide-react": "^0.555.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tough-cookie": "^6.0.1"
  },
  "devDependencies": {
    "@types/keytar": "^4.4.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^39.8.10",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  },
  "author": {
    "name": "keinend",
    "url": "https://github.com/keinend"
  },
  "homepage": "https://github.com/keinend/yandex_huiandex",
  "repository": {
    "type": "git",
    "url": "https://github.com/keinend/yandex_huiandex.git"
  },
  "bugs": {
    "url": "https://github.com/keinend/yandex_huiandex/issues"
  },
  "description": "Yandex Smart Home Control Application",
  "build": {
    "appId": "io.github.keinend.yandexhuiandex",
    "productName": "Yandex Smart Home Control",
    "artifactName": "${productName} Setup v${version}.${ext}",
    "icon": "resources/icon.png",
    "files": [
      "dist/**/*",
      "electron/*.js",
      "electron/*.cjs",
      "node_modules/**/*",
      "resources/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "keinend",
      "repo": "yandex_huiandex",
      "releaseType": "draft"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "resources/icon.icns",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "dmg": {
      "title": "Smart Home Control Installer",
      "iconSize": 128,
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "resources/icon.png",
      "maintainer": "keinend <231264219+keinend@users.noreply.github.com>",
      "description": "Yandex Smart Home Control Application",
      "executableName": "yandex-smart-home-control",
      "desktop": {
        "StartupWMClass": "yandex-smart-home-control"
      }
    }
  }
}
